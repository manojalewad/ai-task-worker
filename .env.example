NODE_ENV=development
PORT=5000
JWT_SECRET=
JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173

# Leave empty (or "memory") to use a built-in throwaway MongoDB — zero setup, data resets on restart, demo data auto-seeded.
# Use a real URI (Atlas / local) to persist data.
MONGO_URI=

# Optional. Without a key the worker uses its deterministic planner and everything still works.
# With a key, Gemini chooses actions (and reads scanned PDFs); on any model failure it falls back to the rules planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional. Without Cloudinary, PDFs are stored in MongoDB. Never on local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=


# Optional
AUTO_SEED=false          # true = seed demo tenants/invoices on startup (always on in memory mode)
MAX_UPLOAD_MB=10
MAX_AGENT_STEPS=14
ERP_CHAOS_RATE=0         # e.g. 0.4 makes the simulated finance system fail 40% of calls, to demo retries
